  // Dead Zone Protocol launcher config. The launcher reads the hosted copy (RemoteUrl in src\Config.cs);
  // this file is the fallback built into the exe. Comments like this one are allowed.
  // Times: "2026-11-01 18:00" = the player's own clock, add an offset for server time: "2026-11-01T18:00:00+01:00".

  "tagline": "EXTRACTION SURVIVAL  //  CHERNARUS",
  "discord": "",
  "website": "",

  // "Playing on ..." status on Discord: create an application at discord.com/developers, paste its Application ID here
  // and upload an image under Rich Presence > Art Assets, its name goes in discordImage. Empty = off.
  "discordAppId": "",
  "discordImage": "",

  // Shown when version is newer than the player's launcher. required: true = old launchers cannot deploy.
  "launcher": { "version": "1.2.0", "url": "", "text": "", "required": false },

  // Top banner for everyone, rotates; long texts scroll. level sets colour + default tag:
  //   info (blue, MOTD) | news (gold) | warn (gold, NOTICE) | maintenance (gold) | alert (red) | error (red)
  //   good (green, LIVE) | event (green) | update (blue)
  // label = your own tag text, link = makes it clickable, from / until = only shown in that time window.
  "banner": [
    { "level": "news", "text": "Welcome to Dead Zone Protocol - the test phase is live. Report bugs on Discord." },
    { "level": "warn", "label": "WIPE", "text": "Expect wipes during the test phase." }
    // { "level": "event", "text": "Double XP weekend!", "from": "2026-10-31 18:00", "until": "2026-11-02 23:59" }
  ],

  // NEWS page, newest first. In text: \n = new line, lines starting with "- " become bullets.
  "news": [
    {
      "date": "2026-10-23",
      "tag": "LAUNCHER",
      "title": "New launcher",
      "text": "The Dead Zone Protocol launcher is here:\n- one click to download every mod and join\n- server status, news and wipe timers",
      "link": ""
    }
  ],

